# Copy this file to .env and fill in real values.
# Generate a secret key with: openssl rand -hex 32

# Postgres (used by docker-compose to create the DB and by the app to connect)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=million_miles

# Must match the credentials above; host is the docker-compose service name
DATABASE_URL=postgresql+asyncpg://postgres:changeme@db:5432/million_miles

# JWT — REQUIRED in production (app will refuse to start if this is left as-is and DEBUG=false)
SECRET_KEY=change-me-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Set to true only during local development — bypasses the SECRET_KEY guard
DEBUG=false
